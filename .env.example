# ============================================================
#  AptosBlobs Mail — Environment Variables Template
# ============================================================
#
#  CARA SETUP:
#  1. Salin file ini: cp .env.example .env
#  2. Isi VITE_SHELBY_API_KEY dengan API key Anda
#  3. Jangan pernah commit file .env ke Git!
#
#  Dapatkan API Key gratis di: https://geomi.dev
#  (Daftar → Dashboard → Create API Key)
# ============================================================

VITE_SHELBY_API_KEY_SHELBYNET=masukkan_api_key_shelbynet_disini
VITE_SHELBY_API_KEY_TESTNET=masukkan_api_key_testnet_disini

# MASTER SECRET — Kunci enkripsi client-side (PBKDF2 Salt)
# Ganti ini dengan string acak unik buatan Anda sendiri!
VITE_SHELBY_APP_SECRET=SHELBY_APP_MASTER_SECRET_2026_XRAY
